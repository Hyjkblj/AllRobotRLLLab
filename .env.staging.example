# Copy to .env.staging on a server. Never commit the populated file.
POSTGRES_DB=allrobotrl
APP_ENV=staging
POSTGRES_USER=allrobotrl
POSTGRES_PASSWORD=replace-with-a-random-secret
MINIO_ROOT_USER=allrobotrl
MINIO_ROOT_PASSWORD=replace-with-a-random-secret
MINIO_BUCKET=allrobotrl
API_PORT=8000
P3_BACKEND=isaac_lab
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# At least 32 random characters; never reuse the database or MinIO password.
WORKER_AUTH_TOKEN=replace-with-a-32-plus-character-random-token
# GPU worker host paths (read-only mounts; keep third-party code outside Git).
ISAACLAB_PATH=/opt/IsaacLab
ISAACSIM_PATH=/opt/isaac-sim
GMR_PATH=/opt/allrobotrl/third_party/GMR-master
GVHMR_PATH=/opt/allrobotrl/third_party/GVHMR-main
UNITREE_MUJOCO_PATH=/opt/allrobotrl/third_party/unitree_mujoco-main
UNITREE_RL_LAB_PATH=/opt/allrobotrl/third_party/unitree_rl_lab-main
G1_MJCF_PATH=/opt/GMR/assets/unitree_g1/g1_mocap_29dof.xml
